# Pro přístup z LAN nastavte konkrétní interní IP svého Docker serveru.
BIND_IP=127.0.0.1
API_PORT=8080
WEB_PORT=8090
IMAGE_TAG=1.4.0
GTFS_INTERVAL_SECONDS=86400
# false: pouze jízdní řád, bez stahování realtime dat
REALTIME_ENABLED=false
REALTIME_INTERVAL_SECONDS=60
REALTIME_MAX_AGE_SECONDS=180

# Jen pro compose.proxy.yaml: existující Docker síť reverse proxy.
PROXY_NETWORK=proxy
