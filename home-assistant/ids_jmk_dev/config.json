{
  "name": "IDS JMK Parser (Dev)",
  "slug": "ids_jmk_parser_dev",
  "description": "Vývojové sestavení parseru IDS JMK z větve develop.",
  "url": "https://github.com/CooLajz/IDS-JMK",
  "arch": [
    "aarch64",
    "amd64"
  ],
  "image": "ghcr.io/coolajz/ids-jmk-ha",
  "startup": "services",
